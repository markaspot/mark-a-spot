# syntax=docker/dockerfile:1.7

ARG DRUPAL_IMAGE
ARG NGINX_IMAGE=nginx:1.30.4-alpine-slim@sha256:ddde39c6e51f02fde7410c2e9c234cf2d0a4c7bdbbe176aeb37d8ad7ab4eb58c
FROM ${DRUPAL_IMAGE} AS drupal

RUN mkdir -p /app/data/web/sites/default/files \
    && find /app/data/web/sites/default/files -mindepth 1 -delete

FROM ${NGINX_IMAGE}

LABEL org.opencontainers.image.title="Mark-a-Spot nginx runtime" \
      org.opencontainers.image.description="Public nginx runtime paired with the canonical Mark-a-Spot Drupal image" \
      org.opencontainers.image.licenses="GPL-2.0-or-later" \
      org.opencontainers.image.source="https://github.com/markaspot/mark-a-spot"

COPY docker/runtime/nginx.conf /etc/nginx/nginx.conf
COPY docker/runtime/nginx-entrypoint.sh /usr/local/bin/markaspot-nginx-entrypoint
COPY --from=drupal /app/data/web /app/data/web

RUN chmod 0755 /usr/local/bin/markaspot-nginx-entrypoint \
    && mkdir -p /var/cache/nginx /var/run \
    && chown -R 101:101 /var/cache/nginx /var/run

USER 101:101
WORKDIR /app/data

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/nginx-health || exit 1

ENTRYPOINT ["markaspot-nginx-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
